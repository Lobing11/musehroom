/**
 * 按天聚合的统计。
 *
 * 时间轴的分组头要显示「9 月 5 日 300 条」，这里的 300 必须是**那一天的真实条数**。
 * 早先图省事，直接数「已加载的行里属于该天的条数」，结果是这个数字随翻页一路长大
 * （真机反馈：翻到 300 条时显示 300，再翻 50 条就变成 350）——
 * 分组头会被读成「那天一共记了多少」，一个会自己长大的数字就是 bug。
 *
 * 口径说明：只统计 `deleted = 0` 的灵感，并**带上当前筛选条件**
 * （搜关键词时每个分组头显示的应当是「符合条件的那天有几条」）。
 * M3 的热力图也走同一份数据，免得两处各算一套。
 */
export class DayStat {
  /** 本地日期，格式 `YYYY-MM-DD`，与 `DateUtil.dateKey` 完全一致 */
  day: string = '';

  /** 当天符合当前筛选条件的条数 */
  count: number = 0;

  /** 当天置顶的条数：置顶区那一行要显示置顶总数，逐日累加即可 */
  pinnedCount: number = 0;
}
