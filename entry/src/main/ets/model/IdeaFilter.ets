/**
 * 时间轴的筛选条件：关键词 + 标签多选 + 某一天。
 *
 * 语义（M2/M3 与用户确认过的取舍）：
 *   - 关键词：正文 `LIKE '%kw%'`（大小写不敏感由 SQLite 的 LIKE 保证 ASCII 部分）
 *   - 标签：**取交集**，选中的标签必须全部命中（`#产品` + `#灵感` = 两条都有）
 *   - 日期：只保留某一天（本地日期 'YYYY-MM-DD'），来自热力图点某一格
 *   - 三者同时存在时仍是交集：既要含关键词，又要带齐所有标签，还要落在那一天
 *   - 置顶依旧排在最前，不受筛选影响
 *
 * 做成不可变的值对象：查询是异步的，用户可能在上一次查询还没回来时又改了条件，
 * 每次查询都新建一个快照，就不会出现「用新条件渲染旧结果」。
 */
export class IdeaFilter {
  keyword: string = '';
  tagIds: number[] = [];
  /**
   * 只保留某一天（'YYYY-MM-DD'，与 SQL 的 `date(..., 'localtime')`、`DateUtil.dateKey` 同一口径）。
   *
   * 代价说明：按算出来的日期过滤用不上 `created_at` 索引，万条量级要一次全表扫描
   * （实测十几毫秒）。一天只点几次，先用最简单的写法；真慢了再改成时间区间条件。
   */
  dayKey: string = '';
}
