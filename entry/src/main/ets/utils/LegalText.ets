/**
 * 隐私政策的**应用内文案副本**。
 *
 * 为什么单独成文件、而不是散在视图里：
 *   ① 首次启动的提示面板与设置里的全文页要显示**同一套**文案，各写一份必然漂移；
 *   ② 应用市场审核看的正是「应用内是否显著提示、并给出完整条款」，改文案应该只改一个地方；
 *   ③ 纯常量、零依赖 —— 本地单测可以直接断言关键条目还在（见 `entry/src/test/LegalText.test.ets`）。
 *
 * 同步纪律：**改本文件时，同步改 `docs/PRIVACY_POLICY.md` 与 `legal/index.html`**。
 * 后者的公网地址就是下面的 `PRIVACY_POLICY_URL`（AGC 表单里填的也是它），
 * 发布/更新步骤见 `legal/README.md`。
 */

/** 线上隐私政策地址（AGC「隐私政策网址」栏填这个） */
export const PRIVACY_POLICY_URL: string = 'https://lobing11.github.io/musehroom-legal/';

/** 生效日期（改文案时同步改，线上页与 docs 也要一致） */
