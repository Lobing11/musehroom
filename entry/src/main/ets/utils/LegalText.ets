/** 适用应用说明 */
export const PRIVACY_APP_LINE: string = '适用应用：灵感菇（Musehroom，包名 com.lobing.musehroom）';

/** 一条隐私政策条款 */
export interface PrivacySection {
  title: string;
  body: string;
}

/**
 * 首屏摘要：首次启动的提示面板只显示这三条。
